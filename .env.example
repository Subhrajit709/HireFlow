# Postgres connection string. Leave empty locally to use the embedded PGlite database in ./.data
# On Vercel: add a Neon / Postgres integration — it sets DATABASE_URL (or POSTGRES_URL) automatically.
DATABASE_URL=

# Secret used to sign session cookies. Use a long random string in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Seed demo recruiter/candidates/jobs on first boot when the database is empty (default: true)
SEED_DEMO=true
